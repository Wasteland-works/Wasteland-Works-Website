rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isFounder() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "founder";
    }

    match /users/{userId} {
      allow read: if ownsProfile(userId);

      allow create: if ownsProfile(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "user"
        && request.resource.data.membership == "guest"
        && request.resource.data.specialAccess.enabled == false;

      allow update: if ownsProfile(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.membership == resource.data.membership
        && request.resource.data.specialAccess == resource.data.specialAccess;

      allow delete: if false;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isFounder();

      match /notes/{noteId} {
        allow read: if true;
        allow create, update, delete: if isFounder();
      }

      match /files/{fileId} {
        allow read: if true;
        allow create, update, delete: if isFounder();
      }
    }
  }
}
