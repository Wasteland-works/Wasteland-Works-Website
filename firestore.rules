rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isFounder() {
      return signedIn()
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "founder"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.membership == "admin"
        );
    }

    function isTeamMember() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["founder", "employee"];
    }

    function hasDownloadAccess() {
      return signedIn()
        && (
          isFounder()
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.membership in ["member", "supporter", "premium"]
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.specialAccess.enabled == true
        );
    }

    function hasVerifiedCompanyEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@wasteland-works[.]com');
    }

    function isApprovedCofounderEmail() {
      return hasVerifiedCompanyEmail()
        && request.auth.token.email in [
          "lee@wasteland-works.com",
          "ethan@wasteland-works.com",
          "ren@wasteland-works.com",
          "yodhivah@wasteland-works.com"
        ];
    }

    function isStaffAccessUpdate(userId) {
      return ownsProfile(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.membership == "admin"
        && request.resource.data.accountState == "admin"
        && request.resource.data.specialAccess == resource.data.specialAccess
        && hasVerifiedCompanyEmail()
        && (
          request.resource.data.role == resource.data.role
          || (request.resource.data.role == "founder" && isApprovedCofounderEmail())
          || (request.resource.data.role == "employee" && hasVerifiedCompanyEmail() && !isApprovedCofounderEmail())
        );
    }

    match /users/{userId} {
      allow read: if ownsProfile(userId);

      allow create: if ownsProfile(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "user"
        && request.resource.data.membership == "guest"
        && request.resource.data.specialAccess.enabled == false;

      allow update: if (
        ownsProfile(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.membership == resource.data.membership
        && request.resource.data.specialAccess == resource.data.specialAccess
      ) || isStaffAccessUpdate(userId);

      allow delete: if false;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isFounder();

      match /notes/{noteId} {
        allow read: if true;
        allow create, update, delete: if isFounder();
      }

      match /files/{fileId} {
        allow read: if hasDownloadAccess();
        allow create, update, delete: if isFounder();
      }
    }

    match /teamMessages/{messageId} {
      allow read: if isTeamMember()
        && (
          resource.data.kind == "update"
          || resource.data.recipientId == request.auth.uid
          || resource.data.authorId == request.auth.uid
        );
      allow create: if isTeamMember()
        && request.resource.data.keys().hasOnly([
          "authorId", "authorName", "body", "kind", "recipientId", "recipientName",
          "recipientEmail", "readAt", "emailStatus", "createdAt"
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 4000
        && request.resource.data.kind in ["update", "gotIt"]
        && (request.resource.data.kind == "update" || request.resource.data.recipientId is string)
        && request.resource.data.readAt == null
        && request.resource.data.emailStatus in ["pending", "not-needed"]
        && request.resource.data.createdAt == request.time;
      allow update: if isTeamMember()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"])
        && request.resource.data.readAt == request.time;
      allow delete: if isTeamMember()
        && (
          resource.data.authorId == request.auth.uid
          || isFounder()
          || (resource.data.kind == "gotIt" && resource.data.recipientId == request.auth.uid)
        );
    }

    match /teamDirectory/{userId} {
      allow read: if isTeamMember();
      allow create, update: if isTeamMember()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["uid", "username", "usernameLower", "displayName", "email", "role", "updatedAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.role in ["founder", "employee"]
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
